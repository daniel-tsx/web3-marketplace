# Every VITE_* value is public browser configuration. Never put secrets here.
# Local template: copy to .env.local and restart Vite after changes.
# Vite also loads .env.local for builds; ignored files do not protect VITE_* values.
# Do not bulk-copy this local template into Vercel Preview/Production.
# Hosted builds default to same-origin /api: leave VITE_API_URL absent on Vercel.
# Ordinary local Vite defaults to localhost:3001; vercel dev needs /api explicitly.
VITE_API_URL=http://localhost:3001

# Local-only Anvil fixtures. contracts:deploy writes local addresses to .env.local.
# Hosted EVM use requires a chosen testnet ID, public HTTPS RPC and three contracts
# deployed together on that network; local addresses/31337 are not public deployments.
# RPC URLs are browser-visible (also displayed in the UI): no private provider keys.
VITE_CHAIN_ID=31337
VITE_RPC_URL=http://127.0.0.1:8545
VITE_MOCK_USDC_ADDRESS=REPLACE_WITH_LOCAL_MOCK_USDC_ADDRESS
VITE_VEHICLE_NFT_ADDRESS=REPLACE_WITH_LOCAL_VEHICLE_NFT_ADDRESS
VITE_MARKETPLACE_ADDRESS=REPLACE_WITH_LOCAL_MARKETPLACE_ADDRESS

# Local-only Solana fixtures. solana:seed writes local mint IDs to .env.local.
# Hosted use needs a public HTTPS RPC, deployed program/config and matching mints.
# Do not repoint the deterministic local seed accounts at a public network.
# The program ID is compiled into the client; it is not an environment override.
VITE_SOLANA_RPC_URL=http://127.0.0.1:8899
VITE_SOLANA_VEHICLE_MINT=REPLACE_WITH_LOCAL_VEHICLE_MINT
VITE_SOLANA_PAYMENT_MINT=REPLACE_WITH_LOCAL_PAYMENT_MINT

# Sui's public testnet endpoint is safe; placeholder IDs do not enable trading.
# Preview/Production need real package, Market and Vehicle IDs on the same network.
# This client uses gRPC; a replacement must support the browser gRPC client.
VITE_SUI_NETWORK=testnet
VITE_SUI_RPC_URL=https://fullnode.testnet.sui.io:443
VITE_SUI_PACKAGE_ID=REPLACE_WITH_DEPLOYED_PACKAGE_ID
VITE_SUI_MARKETPLACE_OBJECT_ID=REPLACE_WITH_DEPLOYED_MARKET_OBJECT_ID
VITE_SUI_VEHICLE_OBJECT_ID=REPLACE_WITH_DEPLOYED_VEHICLE_OBJECT_ID
# Optional: defaults to <package ID>::musdc::MUSDC when omitted.
# VITE_SUI_PAYMENT_COIN_TYPE=REPLACE_WITH_DEPLOYED_PACKAGE_ID::musdc::MUSDC
