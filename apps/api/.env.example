# Optional server overrides; these match the existing localhost defaults.
# Local template, not a Vercel dashboard import; all values below are non-secret.
# The API does not auto-load .env. Export variables or explicitly load the file
# as documented in docs/operations/verification.md. No session secret is required.
# DATABASE_PATH is relative to the API process working directory (apps/api).
# File-backed SQLite is local/Docker only; hosted Vercel startup is blocked.
DATABASE_PATH=.local/auth.sqlite
# Use the exact browser origin (no path/trailing slash). HTTPS enables Secure cookies.
# After storage migration, set the actual HTTPS origin separately for Preview and
# Production. One fixed Preview value cannot authorize every generated preview URL.
FRONTEND_ORIGIN=http://localhost:5173
API_PORT=3001
# PORT takes precedence over API_PORT when injected by a platform.
# For Docker, set API_HOST=0.0.0.0 and keep DATABASE_PATH on a persistent volume.
# API_HOST=127.0.0.1
# On Vercel omit DATABASE_PATH, API_PORT and API_HOST; PORT is platform-managed.
# VERCEL/VERCEL_ENV are platform-managed. Do not override the hosted SQLite guard.
# No DATABASE_URL reader exists yet; storage credentials belong to the follow-up.
