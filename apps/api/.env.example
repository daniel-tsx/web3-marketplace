# Server-only PostgreSQL configuration. Never copy database URLs into VITE_*.
# Safe local placeholder: create a local role/database and replace the password.
# The API does not auto-load .env; export variables or use --env-file explicitly.
DATABASE_URL=postgresql://vehicle:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/vehicle

# Vercel: set DATABASE_URL to the selected Neon's pooled connection with TLS.
# Keep Preview on an isolated database/branch and Production on its own database.
# Schema migrations/imports prefer a direct connection to that same database.
# Optional for tools only; not needed by the running API or frontend build:
# DATABASE_URL_UNPOOLED=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_ENDPOINT.neon.tech/REPLACE_DATABASE?sslmode=verify-full

# Tests require a separate disposable PostgreSQL database, never Production.
# They create/drop isolated test schemas and do not use DATABASE_URL as a fallback.
# TEST_DATABASE_URL=postgresql://vehicle:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/vehicle_test

# Optional local origin override; defaults match ordinary local Vite.
# Production requires the exact canonical HTTPS FRONTEND_ORIGIN (no path/slash).
# Preview ignores this setting and trusts only https://<platform VERCEL_URL>.
# Enable Vercel system environment variables; do not set VERCEL_URL yourself.
# Use the unique Preview deployment URL, not a branch alias or custom alias.
FRONTEND_ORIGIN=http://localhost:5173
API_PORT=3001
# API_HOST=127.0.0.1
# Containers can use API_HOST=0.0.0.0; PORT takes precedence over API_PORT.
# PORT, VERCEL, VERCEL_ENV and VERCEL_URL are platform-managed.
# No DATABASE_PATH or SQLite fallback exists.
# No session signing secret is required.
