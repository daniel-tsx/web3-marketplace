{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "fastify",
      "entrypoint": "src/index.ts",
      "buildCommand": "pnpm build",
      "devCommand": "pnpm exec tsx src/index.ts",
      "routes": [
        {
          "src": "/api/(.*)",
          "transforms": [
            { "type": "request.path", "op": "set", "args": "/$1" }
          ]
        },
        {
          "src": "/api",
          "transforms": [
            { "type": "request.path", "op": "set", "args": "/" }
          ]
        }
      ]
    },
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "buildCommand": "pnpm build",
      "devCommand": "pnpm dev --port $PORT",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/((?!assets/|@|.*\\.).*)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "rewrites": [
    { "source": "/api/:path(.*)?", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
