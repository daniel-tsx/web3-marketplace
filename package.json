{
  "name": "multichain-vehicle-marketplace",
  "private": true,
  "packageManager": "pnpm@10.26.0",
  "pnpm": { "overrides": { "zod": "4.5.0", "@solana/web3.js>rpc-websockets": "9.3.8" } },
  "scripts": {
    "anvil": "anvil --chain-id 31337",
    "contracts:build": "pnpm --dir packages/contracts build",
    "contracts:test": "pnpm --dir packages/contracts test",
    "contracts:deploy": "pnpm --dir packages/contracts run deploy",
    "dev": "pnpm --dir apps/web dev",
    "api:dev": "pnpm --dir apps/api dev",
    "api:db": "pnpm --dir apps/api db",
    "api:db:import": "pnpm --dir apps/api db:import",
    "api:test": "pnpm --dir apps/api test",
    "execution:test": "pnpm --dir apps/web test",
    "solana:prepare": "pnpm --dir packages/solana prepare:local",
    "solana:validator": "pnpm --dir packages/solana validator",
    "solana:build": "pnpm --dir packages/solana build",
    "solana:deploy": "pnpm --dir packages/solana deploy",
    "solana:seed": "pnpm --dir packages/solana seed",
    "solana:test": "pnpm --dir packages/solana test:anchor",
    "sui:test": "pnpm --dir packages/sui test",
    "sui:move:build": "sui move build --path packages/sui/move",
    "sui:move:test": "sui move test --path packages/sui/move",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm --dir apps/web lint",
    "build": "pnpm --dir apps/web build"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  }
}
